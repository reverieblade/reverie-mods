{
  "schemaVersion": 3,
  "id": "reverie-client",
  "displayName": "Reverie Client Data",
  "version": "0.1.0",
  "description": "Writes the new items, names, icons and blueprints of the installed Reverie mods into the EVE client, so the client knows everything the server adds. It changes only index lines and files of its own, and puts the client's own files back when it is disabled or removed.",
  "kind": "client-package",
  "supportedBackends": ["native"],
  "requires": ["reverie-core"],
  "activation": {"strategy": "client_package"},
  "restart": "client",
  "updates": {"provider": "github", "repository": "KevinBomer/reverie-mods", "asset": "reverie-client-{version}.zip", "channel": "stable", "tagPrefix": "reverie-client-v", "preserveFiles": []},
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.74",
    "helper": {"runtime": "node", "path": "helper.js"},
    "capabilities": ["install", "verify", "prepare_disable", "prepare_remove", "recover"]
  }
}
